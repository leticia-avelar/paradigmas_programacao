#include <stdio.h>
#include <stdbool.h>

int main() {
    float saldo = 1000.0;
    float valor;
    int opcao;
    bool continuar = true;

    while (continuar) {
        printf("\n--- Caixa Eletrônico ---\n");
        printf("1. Consultar saldo\n");
        printf("2. Depositar\n");
        printf("3. Sacar\n");
        printf("4. Encerrar\n");
        printf("Escolha uma opção: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Saldo atual: R$ %.2f\n", saldo);
                break;
            case 2:
                printf("Digite o valor para depósito: ");
                scanf("%f", &valor);
                if (valor > 0) {
                    saldo += valor;
                    printf("Depósito realizado com sucesso!\n");
                } else {
                    printf("Valor inválido!\n");
                }
                break;
            case 3:
                printf("Digite o valor para saque: ");
                scanf("%f", &valor);
                if (valor > 0 && valor <= saldo) {
                    saldo -= valor;
                    printf("Saque realizado com sucesso!\n");
                } else {
                    printf("Saldo insuficiente ou valor inválido!\n");
                }
                break;
            case 4:
                continuar = false;
                printf("Encerrando o sistema...\n");
                break;
            default:
                printf("Opção inválida!\n");
        }
    }

    return 0;
}

